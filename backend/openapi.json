      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Create Role",
        "description": "Create a role under the caller's org-level role or a role below it, holding\nonly permissions the caller has (D17).",
        "operationId": "create_role_api_v1_admin_roles_post",
