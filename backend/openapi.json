  "components": {
    "schemas": {
      "ActiveOrgPermissions": {
        "properties": {
          "org_id": {
            "type": "string",
            "format": "uuid",
            "title": "Org Id"
          },
          "org_role_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Role Id"
          },
          "org_role_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Role Name"
          },
          "org_permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Org Permissions"
          },
          "permissions_by_team": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "propertyNames": {
              "format": "uuid"
            },
            "type": "object",
            "title": "Permissions By Team"
          },
          "member_team_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Member Team Ids"
          },
          "viewable_team_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Viewable Team Ids"
          },
          "can_open_admin": {
            "type": "boolean",
            "title": "Can Open Admin"
          }
        },
        "type": "object",
        "required": [
          "org_id",
          "can_open_admin"
        ],
        "title": "ActiveOrgPermissions",
        "description": "Effective permissions in the token's active org (D4, D9, D13).\nFor showing/hiding UI only — the backend still enforces every action."
      },
      "AuthContextResponse": {
        "properties": {
          "organizations": {
            "items": {
              "$ref": "#/components/schemas/OrgSummary"
            },
            "type": "array",
            "title": "Organizations"
          },
          "pending_invitations": {
            "items": {
              "$ref": "#/components/schemas/InvitationResponse"
            },
            "type": "array",
            "title": "Pending Invitations"
          },
          "active_org": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActiveOrgPermissions"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "organizations",
          "pending_invitations"
        ],
        "title": "AuthContextResponse"
      },
      "AuthMeResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "clerk_user_id": {
            "type": "string",
            "title": "Clerk User Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "active_org_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Org Id"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "clerk_user_id",
          "email",
          "name"
        ],
        "title": "AuthMeResponse"
      },
      "CreateRoleRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50,
            "minLength": 2,
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "parent_role_id": {
            "type": "string",
            "format": "uuid",
            "title": "Parent Role Id"
          },
          "permissions": {
            "items": {
              "type": "string",
              "enum": [
                "create_role",
                "create_team",
                "add_member",
                "upload_document",
                "assign_task",
                "give_strike",
                "view_aggregate",
                "review_strike"
              ]
            },
            "type": "array",
            "title": "Permissions"
          }
        },
        "type": "object",
        "required": [
          "name",
          "parent_role_id"
        ],
        "title": "CreateRoleRequest"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "The error body, published in OpenAPI so the frontend's generated types include it."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvitationResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "org_id": {
            "type": "string",
            "format": "uuid",
            "title": "Org Id"
          },
          "org_name": {
            "type": "string",
            "title": "Org Name"
          },
          "team_id": {
            "type": "string",
            "format": "uuid",
            "title": "Team Id"
          },
          "team_name": {
            "type": "string",
            "title": "Team Name"
          },
          "role_id": {
            "type": "string",
            "format": "uuid",
            "title": "Role Id"
          },
          "role_name": {
            "type": "string",
            "title": "Role Name"
          },
          "invited_by_name": {
            "type": "string",
            "title": "Invited By Name"
          },
          "status": {
            "$ref": "#/components/schemas/InvitationStatusEnum"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "org_id",
          "org_name",
          "team_id",
          "team_name",
          "role_id",
          "role_name",
          "invited_by_name",
          "status",
          "created_at"
        ],
        "title": "InvitationResponse"
      },
      "InvitationStatusEnum": {
        "type": "string",
        "enum": [
          "pending",
          "accepted",
          "expired"
        ],
        "title": "InvitationStatusEnum"
      },
      "OrgSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "clerk_org_id": {
            "type": "string",
            "title": "Clerk Org Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "clerk_org_id"
        ],
        "title": "OrgSummary"
      },
      "ProvisionOrgResponse": {
        "properties": {
          "org": {
            "$ref": "#/components/schemas/OrgSummary"
          },
          "admin_role_id": {
            "type": "string",
            "format": "uuid",
            "title": "Admin Role Id"
          },
          "created": {
            "type": "boolean",
            "title": "Created"
          }
        },
        "type": "object",
        "required": [
          "org",
          "admin_role_id",
          "created"
        ],
        "title": "ProvisionOrgResponse"
      },
      "RoleListResponse": {
        "properties": {
          "roles": {
